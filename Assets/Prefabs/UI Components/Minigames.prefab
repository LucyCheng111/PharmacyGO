  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Information:\nThis is a modified version of the card game slapjack.\nOn
    the right, a question will be presented.\nThe player and opponent will take turns
    drawing a card from their deck, and reveal a potential answer.\nIf you think
    its the right answer for the question, click the newly reveled card (Regardless
    of who drew it)\nIf you get the answer right, you'll get all of the cards drawn
    in the center. If you get it wrong, then 1 of your cards goes to the opponent.
    \nThe game ends when either the player or the opponent has all of the cards,
    or if you run out of all 10 questions.\nRemember, it's a game of speed and precision,
    the opponent will be racing to get the correct answer too!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b828f5f19884e7948ae39651293b870d, type: 2}
