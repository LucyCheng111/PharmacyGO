MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 852911504}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fff26da33d205074eb938083bd275aaa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  responses:
  - lines:
    - I think the doctor said it was called Xalatan
  - lines:
    - "I\u2019ve had trouble with blurry vision for a while, and most of the time
      I can\u2019t see in my periphery"
  - lines:
    - 'Yes, in some ways. I still have trouble seeing sometimes and at times it feels
      like '
  - lines:
    - "Yes, I\u2019ve noticed that my eye lashes have been a bit longer. "
  questions:
  - 'Do you remember the name of what you were taking? '
  - 'What are the symptoms bothering you with your eyes? '
  - 'Has the medication you started helped at all? '
  - 'Have you had any side effects since starting the medication for your eyes? '
  responsesSeen: 
  dialogGiven: 'Hello, I am TJ. I have had some issues with my eyes for a while now.
    I have been using one medication the doctor has prescribed me and while it has
    helped a bit, I am still experiencing symptoms. What else could I do for my eyes? '
  InteractPrompt: {fileID: 73881105}
